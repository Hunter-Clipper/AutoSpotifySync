# Copy to .env and fill in. NEVER commit .env.
# On Unraid these are set as fields in the container template instead.

# --- Spotify (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: enables full-library mode (generate once with `spotify-sync auth`)
SPOTIFY_REFRESH_TOKEN=
# Optional: redirect URI registered in your Spotify app (default http://127.0.0.1:8888/callback)
SPOTIFY_REDIRECT_URI=
# Optional: public-only mode (albums only), comma-separated playlist/album URLs
SPOTIFY_PLAYLIST_URLS=

# --- Plex ---
PLEX_URL=http://192.168.1.x:32400
PLEX_TOKEN=
# Name of your music library (auto-detected if you only have one)
PLEX_MUSIC_LIBRARY=
# Mirror Spotify playlists + Liked Songs into Plex playlists (one way, exact names). Honors DRY_RUN.
PLEX_SYNC_PLAYLISTS=false
# true = log what playlist sync WOULD do without changing Plex, even while downloads are live
PLEX_PLAYLISTS_DRY_RUN=false
# Delete the Plex copy when you remove the playlist from Spotify (only ones this tool created)
PLEX_PLAYLIST_DELETE_REMOVED=true

# --- Downloader ---
DOWNLOADER_URL=http://192.168.1.x:8000
DOWNLOADER_API_KEY=

# --- Paths inside the container (map /music to your Plex music share) ---
MUSIC_DIR=/music
# STAGING_DIR defaults to <config>/staging

# --- Safety / behavior (safe defaults shown) ---
AUTO_DOWNLOAD=false
DRY_RUN=true
MAX_DOWNLOADS_PER_RUN=50
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_RATE_PER_MIN=8
DOWNLOAD_FORMAT=mp3
DOWNLOAD_BITRATE=320k
RETRY_MAX_ATTEMPTS=3
RETRY_COOLDOWN_DAYS=7
MATCH_STRICT_ALBUM=false
MATCH_MIN_CONFIDENCE=0.85
DURATION_TOLERANCE_SEC=12
SYNC_INTERVAL=6h
NOTIFY_URL=
# changes = only when something downloaded/failed; always = every run
NOTIFY_ON=changes
LOG_LEVEL=info
