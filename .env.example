# Copy to .env and fill in. NEVER commit .env.
# On Unraid these are set as fields in the container template instead.

# --- Spotify (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: enables full-library mode (generate once with `spotify-sync auth`)
SPOTIFY_REFRESH_TOKEN=
# Optional: public-only mode, comma-separated playlist/album URLs
SPOTIFY_PLAYLIST_URLS=

# --- Plex ---
PLEX_URL=http://192.168.1.x:32400
PLEX_TOKEN=
# Name of your music library (auto-detected if you only have one)
PLEX_MUSIC_LIBRARY=

# --- Downloader ---
DOWNLOADER_URL=http://192.168.1.x:8000
DOWNLOADER_API_KEY=

# --- Safety / behavior (safe defaults shown) ---
AUTO_DOWNLOAD=false
DRY_RUN=true
MAX_DOWNLOADS_PER_RUN=50
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_RATE_PER_MIN=8
DOWNLOAD_FORMAT=mp3
DOWNLOAD_BITRATE=320k
RETRY_MAX_ATTEMPTS=3
RETRY_COOLDOWN_DAYS=7
MATCH_STRICT_ALBUM=false
MATCH_MIN_CONFIDENCE=0.85
DURATION_TOLERANCE_SEC=5
SYNC_INTERVAL=6h
NOTIFY_URL=
LOG_LEVEL=info
